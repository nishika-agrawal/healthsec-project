# PRODUCTION environment file template.
#
# Copy this to /opt/healthsec/.env.prod on the EC2 server (NOT into git -
# this repo's .gitignore already excludes any ".env.prod" file). Fill in
# real, randomly-generated values - never reuse the local-development
# defaults from backend/.env.example.

# --- Database ---
POSTGRES_USER=healthsec_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=healthsec_db
DATABASE_URL=postgresql://healthsec_user:REPLACE_WITH_A_STRONG_RANDOM_PASSWORD@db:5432/healthsec_db

# --- Backend auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Change these before your first deploy - do not use the local demo password in production.
DEMO_USERNAME=demo_doctor
DEMO_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# --- CORS ---
# The public URL the frontend is served from (your EC2 Elastic IP or domain).
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN

# --- Deployment policy (Phase 8) ---
DEPLOYMENT_MANDATORY_SCANNERS=trivy,dependency_check,sonarqube

# --- Images to deploy (Phase 10) ---
# Built and pushed automatically by the CI/CD pipeline. Replace
# YOUR_GITHUB_USERNAME/YOUR_REPO with your actual repository.
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/YOUR_REPO-backend:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/YOUR_REPO-frontend:latest
