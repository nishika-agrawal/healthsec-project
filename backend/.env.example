# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the actual ".env" file to GitHub.

APP_ENV=development

# PostgreSQL connection string
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://healthsec_user:healthsec_pass@localhost:5432/healthsec_db

# General secret key (reserved for future use)
SECRET_KEY=change-this-secret-key-in-your-env-file

# JWT settings used for login tokens. Generate a random string for real use,
# e.g. run: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-jwt-secret-key-in-your-env-file
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo login user, seeded automatically the first time the backend starts.
# Change these values - do not use the defaults outside of local development.
DEMO_USERNAME=demo_doctor
DEMO_PASSWORD=ChangeMe123!

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Phase 8: which scanners must report status "ok" for a build to be
# eligible for automatic deployment approval. Comma-separated.
DEPLOYMENT_MANDATORY_SCANNERS=trivy,dependency_check,sonarqube
